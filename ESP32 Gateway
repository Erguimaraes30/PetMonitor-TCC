#include <WiFi.h>
#include <esp_now.h>
#include "AdafruitIO_WiFi.h"
#include "secrets.h"

// =======================
// WIFI / ADAFRUIT IO
// =======================

#define WIFI_SSID SECRET_WIFI_SSID
#define WIFI_PASS SECRET_WIFI_PASS

#define IO_USERNAME SECRET_IO_USERNAME
#define IO_KEY SECRET_IO_KEY

AdafruitIO_WiFi io(IO_USERNAME, IO_KEY, WIFI_SSID, WIFI_PASS);

AdafruitIO_Feed *feedBPM    = io.feed("bpm");
AdafruitIO_Feed *feedIR     = io.feed("ir");
AdafruitIO_Feed *feedStatus = io.feed("status");

// =======================
// LIMITE DE CONTATO PELO IR
// =======================

const long LIMITE_IR_CONTATO = 500;

// =======================
// ESTRUTURA DOS DADOS
// TEM QUE SER IGUAL NO SENSOR
// =======================

typedef struct struct_message {
  int bpm;
  long ir;
  char status[32];
} struct_message;

struct_message dadosRecebidos;

bool recebeuDados = false;
bool dadoNovo = false;

unsigned long ultimoEnvioAdafruit = 0;
const unsigned long intervaloEnvioAdafruit = 10000; // envia a cada 10 segundos

unsigned long ultimoRecebimento = 0;
unsigned long ultimoAvisoEspera = 0;

// =======================
// TRATAMENTO DE CONTATO
// =======================

void validarContatoPorIR() {
  if (dadosRecebidos.ir < LIMITE_IR_CONTATO) {
    dadosRecebidos.bpm = 0;
    strcpy(dadosRecebidos.status, "sem_contato");
  }
}

// =======================
// CALLBACK ESP-NOW
// =======================

void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
  memcpy(&dadosRecebidos, incomingData, sizeof(dadosRecebidos));

  recebeuDados = true;
  dadoNovo = true;
  ultimoRecebimento = millis();

  // Se o IR for menor que 500, considera sem contato e zera o BPM
  validarContatoPorIR();

  Serial.println();
  Serial.println("Dados recebidos via ESP-NOW:");

  Serial.print("BPM: ");
  Serial.println(dadosRecebidos.bpm);

  Serial.print("IR: ");
  Serial.println(dadosRecebidos.ir);

  Serial.print("Status: ");
  Serial.println(dadosRecebidos.status);

  if (dadosRecebidos.ir < LIMITE_IR_CONTATO) {
    Serial.println("Leitura sem contato: IR abaixo de 500.");
  }

  Serial.println("--------------------------------");
}

// =======================
// SETUP
// =======================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("Iniciando ESP32 Gateway...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);

  Serial.println("Conectando ao Adafruit IO...");
  io.connect();

  while (io.status() < AIO_CONNECTED) {
    Serial.print(".");
    io.run();
    delay(500);
  }

  Serial.println();
  Serial.println("Conectado ao Adafruit IO!");

  Serial.print("MAC Address deste Gateway: ");
  Serial.println(WiFi.macAddress());

  Serial.print("Canal Wi-Fi usado: ");
  Serial.println(WiFi.channel());

  Serial.println("Inicializando ESP-NOW...");

  if (esp_now_init() != ESP_OK) {
    Serial.println("Erro ao inicializar ESP-NOW.");

    while (1) {
      delay(1000);
    }
  }

  esp_now_register_recv_cb(OnDataRecv);

  Serial.println("Gateway pronto para receber dados do Sensor.");
  Serial.println("--------------------------------");
}

// =======================
// LOOP
// =======================

void loop() {
  io.run();

  // Aviso enquanto ainda nao recebeu nada do Sensor
  if (!recebeuDados && millis() - ultimoAvisoEspera >= 5000) {
    ultimoAvisoEspera = millis();
    Serial.println("Aguardando dados do ESP32 Sensor via ESP-NOW...");
  }

  // Se recebeu dados, envia ao Adafruit a cada intervalo
  if (recebeuDados && millis() - ultimoEnvioAdafruit >= intervaloEnvioAdafruit) {
    ultimoEnvioAdafruit = millis();

    // Garante novamente que IR abaixo de 500 zere o BPM antes de enviar
    validarContatoPorIR();

    Serial.println("Enviando dados para Adafruit IO...");

    feedIR->save(dadosRecebidos.ir);
    feedStatus->save(dadosRecebidos.status);

    if (dadosRecebidos.bpm > 0) {
      feedBPM->save(dadosRecebidos.bpm);
      Serial.println("BPM enviado.");
    } else {
      Serial.println("BPM zerado. Nao enviado.");
    }

    Serial.print("Ultimo dado recebido ha ");
    Serial.print((millis() - ultimoRecebimento) / 1000);
    Serial.println(" segundos.");

    if (dadoNovo) {
      Serial.println("Status do pacote: dado novo recebido.");
      dadoNovo = false;
    } else {
      Serial.println("Status do pacote: reenviando ultimo dado recebido.");
    }

    if (dadosRecebidos.ir < LIMITE_IR_CONTATO) {
      Serial.println("Status do contato: sem contato com o sensor.");
    } else {
      Serial.println("Status do contato: contato detectado.");
    }

    Serial.println("Envio finalizado.");
    Serial.println("--------------------------------");
  }

  delay(10);
}
